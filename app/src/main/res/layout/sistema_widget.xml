<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="#0E1623">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="СИСТЕМА" android:textColor="#6FE7FF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 6" android:textColor="#F2F7FC" android:textSize="34sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Уровень 1" android:textColor="#D8B56A" android:textSize="12sp" />
    <TextView android:id="@+id/widget_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Открыть задания" android:textColor="#8291A6" android:textSize="10sp" />
</LinearLayout>
